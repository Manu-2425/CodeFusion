# Cyber Buddy Backend Configuration

# Express server
PORT=5001

# Secret used to sign the login session cookie (required).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cyberbuddy

# Replace with your local PostgreSQL username
DB_USER=your_postgres_username

# Add only if your PostgreSQL installation requires a password
# DB_PASSWORD=your_local_password
